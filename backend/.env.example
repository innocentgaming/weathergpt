# WeatherGPT Configuration Example
PORT=8000
DEMO_MODE=True
DATABASE_URL=sqlite:///./weathergpt.db

# Conversational AI (Gemini or OpenAI API Key)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here

# Weather Provider
OPENWEATHER_API_KEY=your_openweather_api_key_here
